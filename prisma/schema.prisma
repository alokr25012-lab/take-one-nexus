generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                    @id @default(autoincrement()) @db.UnsignedInt
  name                String                 @db.VarChar(120)
  email               String                 @unique(map: "uq_users_email") @db.VarChar(150)
  password            String                 @db.VarChar(255)
  role                String?                @db.VarChar(100)
  college             String?                @db.VarChar(150)
  city                String?                @db.VarChar(120)
  bio                 String?                @db.Text
  skills              String?                @db.Text
  portfolio           String?                @db.VarChar(255)
  avatar_url          String?                @db.VarChar(255)
  created_at                  DateTime               @default(now()) @db.Timestamp(0)
  updated_at                  DateTime               @default(now()) @updatedAt @db.Timestamp(0)
  gender                      String?                @db.VarChar(20)
  credits                     Int                    @default(0) @db.UnsignedInt
  display_preference          String?                @default("Show Real Name Only") @db.VarChar(50)
  screen_name                 String?                @db.VarChar(100)
  social_links                String?                @db.Text
  email_verified              Boolean                @default(false)
  email_verified_at           DateTime?              @db.Timestamp(0)
  verification_token          String?                @unique(map: "uq_users_verification_token") @db.VarChar(255)
  verification_token_expires  DateTime?              @db.Timestamp(0)
  reset_token                 String?                @unique(map: "uq_users_reset_token") @db.VarChar(255)
  reset_token_expires         DateTime?              @db.Timestamp(0)
  secondary_role              String?                @db.VarChar(100)
  collaboration_owned CollaborationRequest[] @relation("OwnedRequests")
  collaboration_reqs  CollaborationRequest[] @relation("RequesterRequests")
  issues              Issue[]
  moderation_logs     ModerationLog[]
  sent_messages       Message[]              @relation("SentMessages")
  notifications       notifications[]
  scripts             Script[]
  task_submissions    TaskSubmission[]
  memberships         ConversationMember[]
  transactions        CreditTransaction[]
  completed_tasks     UserCompletedTask[]
  analytics_events    AnalyticsEvent[]
  availability        String?                @default("Available") @db.VarChar(50)
  community_memberships   CommunityMember[]
  community_subscriptions CommunitySubscription[]
  invitee_invitations     CommunityInvitation[]  @relation("InviteeInvitations")
  inviter_invitations     CommunityInvitation[]  @relation("InviterInvitations")
  community_join_requests CommunityJoinRequest[]
  group_join_requests     GroupJoinRequest[]
  portfolio_works         PortfolioWork[]
  ratings_received        UserRating[]           @relation("UserRatingsReceived")
  ratings_given           UserRating[]           @relation("UserRatingsGiven")
  website_offers_received WebsiteOffer[]         @relation("UserOffers")
  website_offers_created  WebsiteOffer[]         @relation("AdminOffers")
  website_orders          WebsiteOrder[]         @relation("UserOrders")
  website_maintenance     WebsiteMaintenance[]   @relation("UserMaintenance")
  community_posts         CommunityPost[]
  post_likes              CommunityPostLike[]
  post_comments           CommunityPostComment[]
  profile_reminder_logs   ProfileReminderLog[]

  @@index([secondary_role], map: "idx_users_secondary_role")
  @@index([email_verified], map: "idx_users_email_verified")
  @@map("users")
}

model AnalyticsEvent {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id     Int      @db.UnsignedInt
  event_type  String   @db.VarChar(50)
  target_id   Int?     @db.UnsignedInt
  visitor_ip  String?  @db.VarChar(100)
  created_at  DateTime @default(now()) @db.Timestamp(0)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([event_type])
  @@map("analytics_events")
}

model Script {
  id                 Int                    @id @default(autoincrement()) @db.UnsignedInt
  user_id            Int?                   @db.UnsignedInt
  title              String                 @db.VarChar(180)
  genre              String?                @db.VarChar(80)
  synopsis           String?                @db.Text
  poster_url         String?                @db.VarChar(255)
  roles_needed       String?                @db.VarChar(255)
  status             String                 @default("Open for collaboration") @db.VarChar(80)
  created_at         DateTime               @default(now()) @db.Timestamp(0)
  updated_at         DateTime               @default(now()) @updatedAt @db.Timestamp(0)
  media_links        String?                @db.Text
  role_data          String?                @db.Text
  work_type          String                 @default("Script") @db.VarChar(50)
  approval_status    String                 @default("pending") @db.VarChar(50)
  approved_by        Int?                   @db.UnsignedInt
  approved_at        DateTime?              @db.Timestamp(0)
  moderation_notes   String?                @db.Text
  payment_status     String                 @default("pending") @db.VarChar(50)
  payment_id         String?                @db.VarChar(255)
  payment_verified   Boolean                @default(false)
  collaboration_reqs CollaborationRequest[]
  user               User?                  @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "idx_scripts_user_id")
  @@index([genre], map: "idx_scripts_genre")
  @@map("scripts")
}

model CollaborationRequest {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  script_id    Int      @db.UnsignedInt
  requester_id Int      @db.UnsignedInt
  owner_id     Int      @db.UnsignedInt
  message      String?  @db.Text
  status       String   @default("pending") @db.VarChar(40)
  created_at   DateTime @default(now()) @db.Timestamp(0)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamp(0)
  owner        User     @relation("OwnedRequests", fields: [owner_id], references: [id], onDelete: Cascade)
  requester    User     @relation("RequesterRequests", fields: [requester_id], references: [id], onDelete: Cascade)
  script       Script   @relation(fields: [script_id], references: [id], onDelete: Cascade)

  @@unique([script_id, requester_id], map: "uq_script_requester")
  @@index([owner_id], map: "idx_requests_owner_id")
  @@index([requester_id], map: "idx_requests_requester_id")
  @@map("collaboration_requests")
}

model Conversation {
  id         Int                  @id @default(autoincrement()) @db.UnsignedInt
  created_at DateTime             @default(now()) @db.Timestamp(0)
  updated_at DateTime             @default(now()) @updatedAt @db.Timestamp(0)
  avatar_url String?              @db.VarChar(255)
  is_group   Boolean              @default(false)
  name       String?              @db.VarChar(255)
  messages   Message[]
  members    ConversationMember[]
  tasks      Task[]
  community_groups CommunityGroup[]

  @@map("conversations")
}

model ConversationMember {
  id              Int          @id @default(autoincrement()) @db.UnsignedInt
  conversation_id Int          @db.UnsignedInt
  user_id         Int          @db.UnsignedInt
  role            String       @default("Member") @db.VarChar(50)
  joined_at       DateTime     @default(now()) @db.Timestamp(0)
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([conversation_id, user_id])
  @@map("conversation_members")
}

model Task {
  id              Int          @id @default(autoincrement()) @db.UnsignedInt
  conversation_id Int?         @db.UnsignedInt
  creator_id      Int?         @db.UnsignedInt
  assignee_id     Int?         @db.UnsignedInt
  title           String       @db.VarChar(255)
  description     String?      @db.Text
  credits         Int          @default(0) @db.UnsignedInt
  category        String       @default("general") @db.VarChar(100)
  active          Boolean      @default(true)
  status          String       @default("Pending") @db.VarChar(50)
  priority        String       @default("Medium") @db.VarChar(50)
  due_date        DateTime?    @db.Timestamp(0)
  reward_credits  Int          @default(0) @db.UnsignedInt
  approval_status String       @default("Pending") @db.VarChar(50)
  completed_at    DateTime?    @db.Timestamp(0)
  approved_at     DateTime?    @db.Timestamp(0)
  created_at      DateTime     @default(now()) @db.Timestamp(0)
  updated_at      DateTime     @default(now()) @updatedAt @db.Timestamp(0)
  conversation    Conversation? @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  submissions     TaskSubmission[]

  @@map("tasks")
}

model TaskSubmission {
  id              Int      @id @default(autoincrement()) @db.UnsignedInt
  task_id         Int      @db.UnsignedInt
  user_id         Int      @db.UnsignedInt
  status          String   @default("pending") @db.VarChar(50)
  credits_awarded Int      @default(0) @db.UnsignedInt
  created_at      DateTime @default(now()) @db.Timestamp(0)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamp(0)
  task            Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([task_id, user_id], map: "uq_task_submission_user")
  @@index([user_id], map: "idx_task_submissions_user_id")
  @@index([status], map: "idx_task_submissions_status")
  @@map("task_submissions")
}

model CreditTransaction {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id     Int      @db.UnsignedInt
  amount      Int      @db.Int
  reason      String   @db.VarChar(255)
  type        String   @db.VarChar(20) // 'CREDIT' or 'DEBIT'
  created_at  DateTime @default(now()) @db.Timestamp(0)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("credit_transactions")
}

model Issue {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  user_id         Int?      @db.UnsignedInt
  title           String    @db.VarChar(255)
  description     String    @db.Text
  location        String?   @db.VarChar(255)
  severity        String    @default("low") @db.VarChar(50)
  screenshot      String?   @db.VarChar(255)
  status          String    @default("open") @db.VarChar(50)
  priority        String    @default("medium") @db.VarChar(50)
  assigned_admin  Int?      @db.UnsignedInt
  resolved_at     DateTime? @db.Timestamp(0)
  platform_source String    @default("main-website") @db.VarChar(50)
  issue_type      String?   @db.VarChar(100)
  created_at      DateTime  @default(now()) @db.Timestamp(0)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamp(0)
  user            User?     @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "issues_user_id_fkey")
  @@map("issues")
}

model Message {
  id              Int          @id @default(autoincrement()) @db.UnsignedInt
  conversation_id Int          @db.UnsignedInt
  sender_id       Int?         @db.UnsignedInt
  content         String       @db.Text
  is_read         Boolean      @default(false)
  created_at      DateTime     @default(now()) @db.Timestamp(0)
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender          User?        @relation("SentMessages", fields: [sender_id], references: [id])

  @@index([conversation_id], map: "idx_messages_conversation_id")
  @@index([sender_id], map: "idx_messages_sender_id")
  @@map("messages")
}

model notifications {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id    Int      @db.UnsignedInt
  type       String   @db.VarChar(80)
  title      String   @db.VarChar(160)
  body       String?  @db.Text
  link_url   String?  @db.VarChar(255)
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
  users      User     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_notifications_user")

  @@index([user_id, is_read, created_at], map: "idx_notifications_user_read")
}

model CreditTask {
  id                Int                  @id @default(autoincrement()) @db.UnsignedInt
  name              String               @db.VarChar(255)
  description       String?              @db.Text
  credits_rewarded  Int                  @db.UnsignedInt
  is_active         Boolean              @default(true)
  trigger_type      String               @db.VarChar(100) // e.g. 'verify_email', 'submit_script'
  created_at        DateTime             @default(now()) @db.Timestamp(0)
  completed_by      UserCompletedTask[]

  @@map("credit_tasks")
}

model UserCompletedTask {
  id               Int        @id @default(autoincrement()) @db.UnsignedInt
  user_id          Int        @db.UnsignedInt
  task_id          Int        @db.UnsignedInt
  completed_at     DateTime   @default(now()) @db.Timestamp(0)
  credits_awarded  Int        @db.UnsignedInt
  user             User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  task             CreditTask @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@unique([user_id, task_id])
  @@index([user_id])
  @@index([task_id])
  @@map("user_completed_tasks")
}

model ScriptDraft {
  id           Int                  @id @default(autoincrement()) @db.UnsignedInt
  user_id      Int?                 @db.UnsignedInt
  title        String               @db.VarChar(180)
  genre        String?              @db.VarChar(80)
  synopsis     String?              @db.Text
  poster_url   String?              @db.VarChar(255)
  roles_needed String?              @db.VarChar(255)
  status       String               @default("Open for collaboration") @db.VarChar(80)
  media_links  String?              @db.Text
  role_data    String?              @db.Text
  work_type    String               @default("Script") @db.VarChar(50)
  temp_path    String?              @db.VarChar(255)
  metadata     Json?
  expires_at   DateTime?            @db.Timestamp(0)
  created_at   DateTime             @default(now()) @db.Timestamp(0)
  updated_at   DateTime             @default(now()) @db.Timestamp(0)
  payments     ScriptUploadPayment[]

  @@index([user_id], map: "idx_drafts_user_id")
  @@map("script_drafts")
}

model ModerationLog {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  moderator_id Int?     @db.UnsignedInt
  action       String   @db.VarChar(100)
  script_id    Int?     @db.UnsignedInt
  created_at   DateTime @default(now()) @db.Timestamp(0)
  moderator    User?    @relation(fields: [moderator_id], references: [id], onDelete: SetNull)

  @@index([moderator_id], map: "idx_moderation_logs_moderator_id")
  @@index([script_id], map: "idx_moderation_logs_script_id")
  @@map("moderation_logs")
}

model ScriptUploadPayment {
  id                  Int          @id @default(autoincrement()) @db.UnsignedInt
  user_id             Int          @db.UnsignedInt
  draft_id            Int?         @db.UnsignedInt
  script_id           Int?         @db.UnsignedInt
  razorpay_order_id   String       @unique(map: "uq_payments_order_id") @db.VarChar(255)
  razorpay_payment_id String?      @db.VarChar(255)
  razorpay_signature  String?      @db.VarChar(255)
  amount              Decimal      @default(49.00) @db.Decimal(10, 2)
  currency            String       @default("INR") @db.VarChar(10)
  status              String       @default("pending") @db.VarChar(50)
  created_at          DateTime     @default(now()) @db.Timestamp(0)
  updated_at          DateTime     @default(now()) @db.Timestamp(0)
  draft               ScriptDraft? @relation(fields: [draft_id], references: [id], onDelete: SetNull)

  @@index([user_id], map: "idx_payments_user_id")
  @@index([draft_id], map: "idx_payments_draft_id")
  @@map("script_upload_payments")
}

model PaymentSystem {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  name        String   @unique(map: "uq_payment_systems_name") @db.VarChar(100)
  code        String   @unique(map: "uq_payment_systems_code") @db.VarChar(50)
  amount      Decimal  @default(49.00) @db.Decimal(10, 2)
  currency    String   @default("INR") @db.VarChar(10)
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(0)

  @@map("payment_systems")
}

model Community {
  id              Int                     @id @default(autoincrement()) @db.UnsignedInt
  name            String                  @db.VarChar(255)
  description     String?                 @db.Text
  avatar_url      String?                 @db.VarChar(255)
  banner_url      String?                 @db.VarChar(255)
  owner_id        Int                     @db.UnsignedInt
  max_members     Int                     @db.UnsignedInt
  created_at      DateTime                @default(now()) @db.Timestamp(0)
  updated_at      DateTime                @default(now()) @updatedAt @db.Timestamp(0)
  
  members         CommunityMember[]
  groups          CommunityGroup[]
  subscriptions   CommunitySubscription[]
  invitations     CommunityInvitation[]
  join_requests   CommunityJoinRequest[]
  posts           CommunityPost[]

  @@map("communities")
}

model CommunityMember {
  id              Int          @id @default(autoincrement()) @db.UnsignedInt
  community_id    Int          @db.UnsignedInt
  user_id         Int          @db.UnsignedInt
  role            String       @default("Member") @db.VarChar(50)
  joined_at       DateTime     @default(now()) @db.Timestamp(0)
  
  community       Community    @relation(fields: [community_id], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([community_id, user_id])
  @@map("community_members")
}

model CommunityGroup {
  id              Int          @id @default(autoincrement()) @db.UnsignedInt
  community_id    Int          @db.UnsignedInt
  conversation_id Int          @db.UnsignedInt
  name            String       @db.VarChar(255)
  canMembersMessage Boolean    @default(true)
  groupSettings   Json?
  created_at      DateTime     @default(now()) @db.Timestamp(0)
  updated_at      DateTime     @default(now()) @updatedAt @db.Timestamp(0)
  
  community       Community    @relation(fields: [community_id], references: [id], onDelete: Cascade)
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  join_requests   GroupJoinRequest[]

  @@unique([community_id, conversation_id])
  @@map("community_groups")
}

model CommunitySubscription {
  id                  Int       @id @default(autoincrement()) @db.UnsignedInt
  user_id             Int       @db.UnsignedInt
  community_id        Int?      @db.UnsignedInt
  plan_type           String    @db.VarChar(50)
  max_members         Int       @db.UnsignedInt
  price               Decimal   @db.Decimal(10, 2)
  currency            String    @default("INR") @db.VarChar(10)
  razorpay_order_id   String    @unique @db.VarChar(255)
  razorpay_payment_id String?   @db.VarChar(255)
  razorpay_signature  String?   @db.VarChar(255)
  status              String    @default("pending") @db.VarChar(50)
  created_at          DateTime  @default(now()) @db.Timestamp(0)
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamp(0)
  
  user                User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  community           Community? @relation(fields: [community_id], references: [id], onDelete: Cascade)

  @@map("community_subscriptions")
}

model CommunityPermission {
  id                 Int      @id @default(autoincrement()) @db.UnsignedInt
  role               String   @unique @db.VarChar(50)
  can_manage_groups  Boolean  @default(false)
  can_manage_members Boolean  @default(false)
  can_write_messages Boolean  @default(true)
  created_at         DateTime @default(now()) @db.Timestamp(0)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamp(0)

  @@map("community_permissions")
}

model CommunityPricingConfig {
  id                Int      @id @default(autoincrement()) @db.UnsignedInt
  plan_type         String   @unique @db.VarChar(50)
  base_price        Decimal  @db.Decimal(10, 2)
  max_members       Int      @db.UnsignedInt
  per_member_price  Decimal  @default(0.00) @db.Decimal(10, 2)
  created_at        DateTime @default(now()) @db.Timestamp(0)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamp(0)

  @@map("community_pricing_configs")
}

model CommunityInvitation {
  id              Int          @id @default(autoincrement()) @db.UnsignedInt
  community_id    Int          @db.UnsignedInt
  invitee_id      Int          @db.UnsignedInt
  inviter_id      Int          @db.UnsignedInt
  status          String       @default("PENDING") @db.VarChar(50)
  expires_at      DateTime?    @db.Timestamp(0)
  created_at      DateTime     @default(now()) @db.Timestamp(0)
  updated_at      DateTime     @default(now()) @updatedAt @db.Timestamp(0)

  community       Community    @relation(fields: [community_id], references: [id], onDelete: Cascade)
  invitee         User         @relation("InviteeInvitations", fields: [invitee_id], references: [id], onDelete: Cascade)
  inviter         User         @relation("InviterInvitations", fields: [inviter_id], references: [id], onDelete: Cascade)

  @@unique([community_id, invitee_id])
  @@index([invitee_id])
  @@index([community_id])
  @@map("community_invitations")
}

model CommunityJoinRequest {
  id              Int          @id @default(autoincrement()) @db.UnsignedInt
  community_id    Int          @db.UnsignedInt
  user_id         Int          @db.UnsignedInt
  status          String       @default("PENDING") @db.VarChar(50)
  created_at      DateTime     @default(now()) @db.Timestamp(0)
  updated_at      DateTime     @default(now()) @updatedAt @db.Timestamp(0)

  community       Community    @relation(fields: [community_id], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([community_id, user_id])
  @@index([user_id])
  @@index([community_id])
  @@map("community_join_requests")
}

model GroupJoinRequest {
  id              Int            @id @default(autoincrement()) @db.UnsignedInt
  group_id        Int            @db.UnsignedInt
  user_id         Int            @db.UnsignedInt
  status          String         @default("PENDING") @db.VarChar(50)
  created_at      DateTime       @default(now()) @db.Timestamp(0)
  updated_at      DateTime       @default(now()) @updatedAt @db.Timestamp(0)

  group           CommunityGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([group_id, user_id])
  @@map("group_join_requests")
}

model PortfolioWork {
  id              Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id         Int      @db.UnsignedInt
  title           String   @db.VarChar(180)
  genre           String?  @db.VarChar(80)
  synopsis        String?  @db.Text
  media_links     String?  @db.Text
  role_data       String?  @db.Text
  work_type       String   @default("Script") @db.VarChar(50)
  status          String   @default("Portfolio Item") @db.VarChar(80)
  created_at      DateTime @default(now()) @db.Timestamp(0)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamp(0)
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_portfolio_work_user_id")
  @@map("portfolio_work")
}

model UserRating {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  rated_user_id Int      @db.UnsignedInt
  rated_by_id   Int      @db.UnsignedInt
  rating        Int      @db.TinyInt
  created_at    DateTime @default(now()) @db.Timestamp(0)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamp(0)

  rated_user    User     @relation("UserRatingsReceived", fields: [rated_user_id], references: [id], onDelete: Cascade)
  rated_by      User     @relation("UserRatingsGiven", fields: [rated_by_id], references: [id], onDelete: Cascade)

  @@unique([rated_user_id, rated_by_id], map: "uq_rated_user_rated_by")
  @@index([rated_user_id], map: "idx_ratings_rated_user_id")
  @@index([rated_by_id], map: "idx_ratings_rated_by_id")
  @@map("user_ratings")
}

model WebsiteOffer {
  id                         Int            @id @default(autoincrement()) @db.UnsignedInt
  user_id                    Int            @db.UnsignedInt
  admin_id                   Int            @db.UnsignedInt
  website_type               String         @db.VarChar(100)
  description                String?        @db.Text
  features                   Json?          // List of features included
  price                      Decimal        @db.Decimal(10, 2)
  advance_payment            Decimal        @db.Decimal(10, 2)
  final_payment              Decimal        @db.Decimal(10, 2)
  timeline_days              Int            @db.UnsignedInt
  status                     String         @default("pending") @db.VarChar(50) // "pending", "accepted", "rejected", "negotiating", "completed"
  negotiation_count          Int            @default(0) @db.UnsignedInt
  selected_maintenance_plan  String?        @db.VarChar(50) // "Annual", "Quarterly", "Monthly"
  annual_price               Decimal?       @db.Decimal(10, 2)
  annual_discount            Decimal?       @db.Decimal(10, 2)
  quarterly_price            Decimal?       @db.Decimal(10, 2)
  monthly_price              Decimal?       @db.Decimal(10, 2)
  selected_maintenance_price Decimal?       @db.Decimal(10, 2)
  negotiation_history        Json?          // List of negotiation rounds
  included_services          Json?          // Included maintenance services as strings
  created_at                 DateTime       @default(now()) @db.Timestamp(0)
  updated_at                 DateTime       @default(now()) @updatedAt @db.Timestamp(0)
  user                       User           @relation("UserOffers", fields: [user_id], references: [id], onDelete: Cascade)
  admin                      User           @relation("AdminOffers", fields: [admin_id], references: [id], onDelete: Cascade)
  orders                     WebsiteOrder[]

  @@index([user_id], map: "idx_website_offers_user_id")
  @@index([admin_id], map: "idx_website_offers_admin_id")
  @@map("website_offers")
}

model WebsiteOrder {
  id                          Int          @id @default(autoincrement()) @db.UnsignedInt
  offer_id                    Int          @db.UnsignedInt
  user_id                     Int          @db.UnsignedInt
  razorpay_order_id_advance   String?      @unique(map: "uq_orders_rp_advance") @db.VarChar(255)
  razorpay_payment_id_advance String?      @db.VarChar(255)
  razorpay_order_id_final     String?      @unique(map: "uq_orders_rp_final") @db.VarChar(255)
  razorpay_payment_id_final   String?      @db.VarChar(255)
  advance_paid                Boolean      @default(false)
  final_paid                  Boolean      @default(false)
  project_status              String       @default("pending_advance") @db.VarChar(50) // "pending_advance", "in_progress", "design_review", "development", "final_review", "pending_final_payment", "completed"
  milestones                  Json?        // List of milestones: [{"id": 1, "title": "Wireframes", "completed": false}, ...]
  delivery_date               DateTime?    @db.Timestamp(0)
  created_at                  DateTime     @default(now()) @db.Timestamp(0)
  updated_at                  DateTime     @default(now()) @updatedAt @db.Timestamp(0)
  offer                       WebsiteOffer @relation(fields: [offer_id], references: [id], onDelete: Cascade)
  user                        User         @relation("UserOrders", fields: [user_id], references: [id], onDelete: Cascade)
  maintenance                 WebsiteMaintenance[]

  @@index([offer_id], map: "idx_website_orders_offer_id")
  @@index([user_id], map: "idx_website_orders_user_id")
  @@map("website_orders")
}

model WebsiteMaintenance {
  id                Int          @id @default(autoincrement()) @db.UnsignedInt
  website_order_id  Int          @db.UnsignedInt
  user_id           Int          @db.UnsignedInt
  plan_type         String       @default("Annual") @db.VarChar(50) // "Annual", "Quarterly", "Monthly"
  custom_price      Decimal      @db.Decimal(10, 2)
  duration_years    Int          @default(1)
  description       String?      @db.Text
  included_services Json?        // List of included features/services as strings
  start_date        DateTime?    @db.Timestamp(0)
  expiry_date      DateTime?    @db.Timestamp(0)
  status            String       @default("pending") @db.VarChar(50) // "pending", "active", "expired", "declined"
  renewal_date      DateTime?    @db.Timestamp(0)
  payment_history   Json?        // List of payments/invoices: [{"type": "purchase" | "renewal", "date": "...", "amount": ..., "receipt": "...", "razorpay_order_id": "...", "razorpay_payment_id": "..."}]
  created_at        DateTime     @default(now()) @db.Timestamp(0)
  updated_at        DateTime     @default(now()) @updatedAt @db.Timestamp(0)

  order             WebsiteOrder @relation(fields: [website_order_id], references: [id], onDelete: Cascade)
  user              User         @relation("UserMaintenance", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([website_order_id], map: "idx_website_maintenance_order_id")
  @@index([user_id], map: "idx_website_maintenance_user_id")
  @@map("website_maintenance")
}

model CommunityPost {
  id           Int                    @id @default(autoincrement()) @db.UnsignedInt
  community_id Int                    @db.UnsignedInt
  author_id    Int                    @db.UnsignedInt
  caption      String?                @db.Text
  media_urls   Json                   // JSON array of image/video URLs
  is_pinned    Boolean                @default(false)
  created_at   DateTime               @default(now()) @db.Timestamp(0)
  updated_at   DateTime               @default(now()) @updatedAt @db.Timestamp(0)

  community    Community              @relation(fields: [community_id], references: [id], onDelete: Cascade)
  author       User                   @relation(fields: [author_id], references: [id], onDelete: Cascade)
  likes        CommunityPostLike[]
  comments     CommunityPostComment[]

  @@index([community_id])
  @@index([author_id])
  @@map("community_posts")
}

model CommunityPostLike {
  id         Int           @id @default(autoincrement()) @db.UnsignedInt
  post_id    Int           @db.UnsignedInt
  user_id    Int           @db.UnsignedInt
  created_at DateTime      @default(now()) @db.Timestamp(0)

  post       CommunityPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([post_id, user_id])
  @@map("community_post_likes")
}

model CommunityPostComment {
  id         Int           @id @default(autoincrement()) @db.UnsignedInt
  post_id    Int           @db.UnsignedInt
  user_id    Int           @db.UnsignedInt
  content    String        @db.Text
  created_at DateTime      @default(now()) @db.Timestamp(0)
  updated_at DateTime      @default(now()) @updatedAt @db.Timestamp(0)

  post       CommunityPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([post_id])
  @@map("community_post_comments")
}

model ProfileReminderLog {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id    Int      @db.UnsignedInt
  sent_at    DateTime @default(now()) @db.Timestamp(0)

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, sent_at])
  @@map("profile_reminder_logs")
}




